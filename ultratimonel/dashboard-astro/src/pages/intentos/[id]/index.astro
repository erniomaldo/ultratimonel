---
// Intento route — intento detail + gates + on-demand logs (T9, F-DA-12, S6/S7/S8).
// Static shell + hydrated <IntentoDetail /> island (breadcrumb parents resolve
// from /api/intentos/{id} → intento.mission, F-DA-15).
//
// output:'static' requires getStaticPaths for dynamic routes (Astro). We
// enumerate intento ids from the dashboard SQLite DB (same resolution as
// dashboard_server.py) so each real intento gets a static shell in dist/. The
// shell is empty of content — the island fetches /api/* in the browser
// (ADR-3), so build-time enumeration never freezes data.
import { DatabaseSync } from 'node:sqlite';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import IntentoDetail from '../../../components/intentos/IntentoDetail.jsx';

export async function getStaticPaths() {
  try {
    const dbPath =
      process.env.ULTRATIMONEL_DB_PATH || `${process.env.HOME}/.hermes/ultratimonel.db`;
    const db = new DatabaseSync(dbPath, { readOnly: true });
    const rows = db.prepare('SELECT id FROM intentos').all();
    db.close();
    return rows.map((r) => ({ params: { id: String(r.id) } }));
  } catch (err) {
    console.error('[getStaticPaths] intento enumeration failed:', err && err.message);
    // DB unavailable at build time — no static shells (dev 3006 still works).
    return [];
  }
}

const { id } = Astro.params;
---

<BaseLayout title={`Intento ${id} · Ultratimonel`}>
  <IntentoDetail client:load id={id} />
</BaseLayout>
