---
// Checklist item fallback shell (Ejecución 8, hierarchical routes) — generic
// shell for checklist items created AFTER the build, so
// /{proyectoName}/{misionId}/{checklistItemId}/ keeps working for ANY item in a
// live dashboard (output:'static' + stdlib http.server, ADR-2/ADR-5).
//
// getStaticPaths cannot enumerate ids that do not exist at build time, so
// dashboard_server.py serves this single shell for non-enumerated items ONLY
// when the item exists AND its mission and project match the URL segments.
// Unknown ids keep a real 404 (S8). The island resolves project + mission id +
// item id from window.location.pathname at runtime and fixes <title> on mount,
// so this one file works for any item.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ItemDetail from '../../components/checklist/ItemDetail.jsx';
---
<BaseLayout title="Ítem · Ultratimonel">
  <ItemDetail client:load />
</BaseLayout>
