# ── Ultratimonel — variables de entorno (ejemplo) ─────────────────────────
# Copia este archivo a .env (o exporta las vars en tu shell/unit) y ajusta
# las rutas a TU máquina. NUNCA subas .env al repo (está en .gitignore).
#
# El MCP client resuelve en este orden:
#   1. Env var explícita (las de abajo)
#   2. Config MCP activa de Hermes (~/.hermes/config.yaml → mcp_servers.ultratimonel)
#   3. Fallback portable (sys.executable / localhost:2993)
# Por eso, si ya tenés la config MCP en Hermes, estas vars son OPCIONALES.

# ── Server MCP ultratimonel (main.py) ─────────────────────────────────────
# ULTRATIMONEL_MCP_CMD=/home/<tu-usuario>/Proyectos/ultratimonel/.venv/bin/python3
# ULTRATIMONEL_MCP_ARGS=/home/<tu-usuario>/Proyectos/ultratimonel/main.py

# ── Nextcloud (gate 1c collective + gate 1e deck) ─────────────────────────
# ULTRATIMONEL_NEXTCLOUD_COMMAND=/home/<tu-usuario>/Proyectos/ultratimonel/.venv/bin/python3
# ULTRATIMONEL_NEXTCLOUD_ARGS=/home/<tu-usuario>/Proyectos/http-to-stdio/http_to_stdio_mcp.py
# ULTRATIMONEL_NEXTCLOUD_URL=https://mcpnextcloud.agendasencilla.com/mcp
# ULTRATIMONEL_NEXTCLOUD_TIMEOUT=600
# ULTRATIMONEL_NEXTCLOUD_HEADERS='{"Authorization": "Bearer <token>"}'

# ── Checkpoint (gate 1b) ──────────────────────────────────────────────────
# ULTRATIMONEL_CHECKPOINT_COMMAND=agentcheckpoint
# ULTRATIMONEL_CHECKPOINT_ARGS=

# ── Runtime ────────────────────────────────────────────────────────────────
# ULTRATIMONEL_DB_PATH=/home/<tu-usuario>/.hermes/ultratimonel.db
# ULTRATIMONEL_DASHBOARD_PORT=3005
# ULTRATIMONEL_PROJECT_MAPS=/home/<tu-usuario>/.hermes/ultratimonel/project_maps.json
# ULTRATIMONEL_GRACE_TURNS=3
